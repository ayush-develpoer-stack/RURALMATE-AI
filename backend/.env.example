# PORT is provided automatically by Render in production. Set it only for local dev.
PORT=5000
# Set NODE_ENV=production on Render. In production JWT_SECRET is mandatory (the
# server refuses to start with an insecure default).
NODE_ENV=development
# Public URL of the deployed frontend (used for CORS). Set to your Vercel URL in prod.
FRONTEND_URL=http://localhost:3000

# Auth — set to a long random string in real use
JWT_SECRET=change-this-to-a-long-random-string

# AI (OpenRouter). If OPENROUTER_API_KEY is empty, backend uses deterministic fallbacks.
# OPENROUTER_MODEL accepts any OpenRouter slug; "openrouter/free" maps to a real free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Legacy/general AI key (optional; unused when OpenRouter is configured)
AI_API_KEY=

# Database (Supabase PostgreSQL). Leave DATABASE_URL empty to run in in-memory demo mode.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only, used at runtime)
DATABASE_URL="postgresql://postgres.kcjnxjwmusoceyfvlqjj:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.kcjnxjwmusoceyfvlqjj:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
